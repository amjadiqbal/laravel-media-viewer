{
    "name": "amjadiqbal/laravel-media-viewer",
    "description": "Show PDFs, video and audio from any Laravel disk without leaking private files: Blade and Livewire components with a pdf.js PDF viewer (page navigation, zoom, search, thumbnails), a Video.js player with HLS (hls.js), signed expiring URLs and Range-aware streaming.",
    "keywords": [
        "laravel",
        "laravel-package",
        "pdf-viewer",
        "pdfjs",
        "pdf.js",
        "video-player",
        "videojs",
        "hls",
        "hls.js",
        "audio-player",
        "private-files",
        "signed-urls",
        "range-requests",
        "blade",
        "livewire"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://amjad.com.pk/laravel/packages/laravel-media-viewer",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-media-viewer/issues",
        "source": "https://github.com/amjadiqbal/laravel-media-viewer",
        "docs": "https://amjad.com.pk/laravel/packages/laravel-media-viewer"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "livewire/livewire": "^3.6|^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "livewire/livewire": "For the <livewire:media-viewer-gallery> component (the Blade components work inside Livewire without it)."
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\MediaViewer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\MediaViewer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\MediaViewer\\MediaViewerServiceProvider"
            ],
            "aliases": {
                "MediaViewer": "AmjadIqbal\\MediaViewer\\Facades\\MediaViewer"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
